#############################################################################
# $Id$
#
# cornell.nff
#   Cornell box modified to dimensions 550x550x550 so that polygons align.
#
#############################################################################

# background color 
b 0.8945 0.8945 0.8945


# ambient light
am 0.25 0.25 0.25

#camera specification
v
from  -0.5 250 -1000
at    0 275 -900
up 0 1 0
angle 40
hither 1.0
resolution 256 256

#light source
la alight 0 0 0


#Figure pawn
xs 2.5 2.5 2.5
   0 1 0 3
   0 0 0
{
    f 1 .8 0   .85 .55 10 0 1
    i 0 pawn_model.aff
}


a 0.0 10.0 250 0


k alight {
    transl 8
    -1 450 800 -250 0 0 0
    1.5 450 800 -250 0 0 0
    
    3.0 0 500 -500 0 0 0
    
    4.5 -450 800 -250 0 0 0
    5.5 -450 800 -250 0 0 0
    
    7.0 0 1000 -100 0 0 0    
    
    8.5 450 800 -250 0 0 0
    11.0 450 800 -250 0 0 0
}
